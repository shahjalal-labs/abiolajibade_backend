# Database Connection (MongoDB / PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/abiolajibade_db?schema=public"
PORT=5000

# Backend URL & Security
BACKEND_BASE_URL="http://localhost:5000"
SUPER_ADMIN_PASSWORD="superadmin_secure_password"
BCRYPT_SALT_ROUNDS=12

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
EXPIRES_IN="7d"

# SMTP Email Dispatch
EMAIL="noreply@example.com"
APP_PASS="smtp_application_password"

# Stripe Payments & Webhooks
STRIPE_PK="pk_test_sample_key"
STRIPE_SK="sk_test_sample_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_secret"
STRIPE_WEBHOOK_URL="http://localhost:5000/api/v1/payment/webhook"

# Object Storage (DigitalOcean Spaces / AWS S3)
DO_SPACES_KEY="sample_spaces_key"
DO_SPACES_SECRET="sample_spaces_secret"
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_BUCKET="sample_bucket"
